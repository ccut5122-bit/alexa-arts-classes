rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isPremium() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPremium == true;
    }

    // ==================== CONTENT (public read, admin write) ====================
    match /subjects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /chapters/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /questions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /quizzes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /dictionary/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /badges/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== NOTIFICATIONS (public read, admin write) ====================
    match /notifications/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==================== CONFIG / SECRETS (admin only) ====================
    match /config/{configId} {
      allow read, write: if isAdmin();
    }

    // ==================== ANALYTICS / INSTALL TRACKING ====================
    match /analytics/{statId} {
      allow read, write: if true;
    }

    // ==================== DYNAMIC CONFIG (themes, banners, notices, exam dates) ====================
    match /dynamicConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== USERS (own profile only) ====================
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin() || request.auth.uid == userId;

      // users/{uid}/quizHistory etc
      match /{document=**} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin() || request.auth.uid == userId;
      }
    }

    // ==================== LEADERBOARD ====================
    match /leaderboard/{period} {
      allow read: if true;
      match /entries/{uid} {
        allow read: if true;
        allow write: if isAdmin() || request.auth.uid == uid;
      }
    }

    // ==================== FORUM ====================
    match /forum/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isSignedIn() && resource.data.authorId == request.auth.uid);

      match /replies/{replyId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }
  }
}